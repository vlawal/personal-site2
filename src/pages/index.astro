---
---

<html lang="en">
  <head>
    <title>Ovie Lawal</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&display=swap" rel="stylesheet">

    <style>
      :root {
        --bg: #0B0B0C;
        --text: #EDEDED;
        --muted: #A3A3A3;
        --soft: #6E6E6E;
        --line: #1C1C1C;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: "Inter", system-ui, -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      main {
        max-width: 880px;
        margin: 0 auto;
        padding: 140px 28px;
      }

      /* NAV */
      nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 120px;
        font-size: 13px;
        color: var(--soft);
      }

      nav a {
        color: var(--soft);
        text-decoration: none;
        margin-left: 18px;
      }

      nav a:hover {
        color: var(--text);
      }

      /* HERO */
      .hero {
        margin-bottom: 140px;
      }

      h1 {
        font-size: 86px;
        letter-spacing: -3px;
        line-height: 0.9;
        margin: 0;
        font-weight: 500;
      }

      .role {
        font-size: 19px;
        color: var(--muted);
        margin-top: 20px;
      }

      .desc {
        font-size: 17px;
        line-height: 1.8;
        color: #CFCFCF;
        max-width: 620px;
        margin-top: 28px;
      }

      section {
        margin-top: 140px;
      }

      .label {
        font-size: 11px;
        letter-spacing: 2.4px;
        color: var(--soft);
        margin-bottom: 26px;
      }

      /* WORK */
      .work-item {
        display: flex;
        justify-content: space-between;
        padding: 18px 0;
        border-bottom: 1px solid var(--line);
        transition: all 0.2s ease;
      }

      .work-item:hover {
        transform: translateX(5px);
        color: #fff;
      }

      .work-meta {
        font-size: 13px;
        color: var(--soft);
      }

      /* subtle entrance */
      .fade {
        animation: fade 0.7s ease-out both;
      }

      @keyframes fade {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
      }

      /* mobile */
      @media (max-width: 640px) {
        h1 {
          font-size: 54px;
        }

        main {
          padding: 100px 20px;
        }

        nav {
          flex-direction: column;
          align-items: flex-start;
          gap: 10px;
        }
      }
    </style>
  </head>

  <body>
    <main>

      <!-- NAV -->
      <nav>
        <div>Ovie Lawal</div>
        <div>
          <a href="#">Work</a>
          <a href="#">About</a>
          <a href="#">Contact</a>
        </div>
      </nav>

      <!-- HERO -->
      <section class="hero fade">
        <h1>Product leader<br/>building AI systems</h1>

        <div class="role">
          AI-native financial systems & enterprise automation.
        </div>

        <div class="desc">
          I design and scale complex fintech and AI products focused on automation,
          working capital systems, and enterprise intelligence.
        </div>
      </section>

      <!-- WORK -->
      <section class="fade">
        <div class="label">SELECTED WORK</div>

        <div>
          <div class="work-item">
            <span>AI Cash Forecasting Platform</span>
            <span class="work-meta">Kyriba</span>
          </div>

          <div class="work-item">
            <span>Trade Finance Optimization Engine</span>
            <span class="work-meta">Enterprise</span>
          </div>

          <div class="work-item">
            <span>Working Capital Intelligence System</span>
            <span class="work-meta">Fintech</span>
          </div>
        </div>
      </section>

      <!-- ABOUT -->
      <section class="fade">
        <div class="label">ABOUT</div>

        <div class="desc">
          I work at the intersection of product management, fintech infrastructure,
          and applied AI. My focus is building systems that automate financial decision-making
          at enterprise scale.
        </div>
      </section>

    </main>
  </body>
</html>
